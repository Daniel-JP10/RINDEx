{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Series regionales por cultivo y anio",
  "type": "object",
  "required": ["version_esquema", "registros"],
  "additionalProperties": false,
  "properties": {
    "version_esquema": { "type": "string" },
    "registros": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cultivo",
          "anio",
          "area_sembrada_ha",
          "area_cosechada_ha",
          "area_no_cosechada_ha",
          "produccion_t",
          "rendimiento_tha",
          "tasa_area_no_cosechada_pct",
          "quiebre_2022",
          "anio_posiblemente_incompleto",
          "clase_enso",
          "oni_anual"
        ],
        "additionalProperties": false,
        "properties": {
          "cultivo": { "type": "string" },
          "anio": { "type": "integer" },
          "area_sembrada_ha": { "type": "integer", "minimum": 0 },
          "area_cosechada_ha": { "type": "integer", "minimum": 0 },
          "area_no_cosechada_ha": { "type": "integer" },
          "produccion_t": { "type": "integer", "minimum": 0 },
          "rendimiento_tha": { "type": "number", "minimum": 0 },
          "tasa_area_no_cosechada_pct": { "type": ["number", "null"] },
          "quiebre_2022": { "type": "boolean" },
          "anio_posiblemente_incompleto": { "type": "boolean" },
          "clase_enso": { "type": "string", "enum": ["nina", "nino", "neutro"] },
          "oni_anual": { "type": "number" }
        }
      }
    }
  }
}
