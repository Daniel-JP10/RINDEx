{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Escenarios de simulacion S1, S2, S3 y combinado",
  "type": "object",
  "required": ["version_esquema", "totales_regionales", "municipios"],
  "additionalProperties": false,
  "properties": {
    "version_esquema": { "type": "string" },
    "totales_regionales": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "cultivo",
          "municipios_elegibles",
          "produccion_anual_media_t",
          "s1_p10_t",
          "s1_p50_t",
          "s1_p90_t",
          "s1_p50_pct_prod",
          "s2_p10_t",
          "s2_p50_t",
          "s2_p90_t",
          "s2_p50_pct_prod",
          "s2_pct_extrapolado",
          "s3_p10_t",
          "s3_p50_t",
          "s3_p90_t",
          "s3_p50_pct_prod",
          "combinado_p10_t",
          "combinado_p50_t",
          "combinado_p90_t",
          "combinado_p50_pct_prod"
        ],
        "additionalProperties": false,
        "properties": {
          "cultivo": { "type": "string" },
          "municipios_elegibles": { "type": "integer" },
          "produccion_anual_media_t": { "type": "integer" },
          "s1_p10_t": { "type": "integer" },
          "s1_p50_t": { "type": "integer" },
          "s1_p90_t": { "type": "integer" },
          "s1_p50_pct_prod": { "type": "number" },
          "s2_p10_t": { "type": "integer" },
          "s2_p50_t": { "type": "integer" },
          "s2_p90_t": { "type": "integer" },
          "s2_p50_pct_prod": { "type": "number" },
          "s2_pct_extrapolado": { "type": "number" },
          "s3_p10_t": { "type": "integer" },
          "s3_p50_t": { "type": "integer" },
          "s3_p90_t": { "type": "integer" },
          "s3_p50_pct_prod": { "type": "number" },
          "combinado_p10_t": { "type": "integer" },
          "combinado_p50_t": { "type": "integer" },
          "combinado_p90_t": { "type": "integer" },
          "combinado_p50_pct_prod": { "type": "number" }
        }
      }
    },
    "municipios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "codigo",
          "nombre",
          "codigo_departamento",
          "departamento",
          "cultivo",
          "area_cosechada_media_anual_ha",
          "produccion_media_anual_t",
          "rendimiento_tha",
          "s1_p10_t",
          "s1_p50_t",
          "s1_p90_t",
          "s2_area_convertible_ha",
          "s2_p10_t",
          "s2_p50_t",
          "s2_p90_t",
          "extrapolado",
          "s3_p10_t",
          "s3_p50_t",
          "s3_p90_t",
          "indicativo",
          "excluido_d4",
          "combinado_p10_t",
          "combinado_p50_t",
          "combinado_p90_t"
        ],
        "additionalProperties": false,
        "properties": {
          "codigo": { "type": "string", "pattern": "^[0-9]{5}$" },
          "nombre": { "type": "string" },
          "codigo_departamento": { "type": "string", "pattern": "^[0-9]{2}$" },
          "departamento": { "type": "string" },
          "cultivo": { "type": "string" },
          "area_cosechada_media_anual_ha": { "type": "integer" },
          "produccion_media_anual_t": { "type": "integer" },
          "rendimiento_tha": { "type": "number" },
          "s1_p10_t": { "type": "integer" },
          "s1_p50_t": { "type": "integer" },
          "s1_p90_t": { "type": "integer" },
          "s2_area_convertible_ha": { "type": "integer" },
          "s2_p10_t": { "type": "integer" },
          "s2_p50_t": { "type": "integer" },
          "s2_p90_t": { "type": "integer" },
          "extrapolado": { "type": "boolean" },
          "s3_p10_t": { "type": "integer" },
          "s3_p50_t": { "type": "integer" },
          "s3_p90_t": { "type": "integer" },
          "indicativo": { "type": "boolean" },
          "excluido_d4": { "type": "boolean" },
          "combinado_p10_t": { "type": "integer" },
          "combinado_p50_t": { "type": "integer" },
          "combinado_p90_t": { "type": "integer" }
        }
      }
    }
  }
}
