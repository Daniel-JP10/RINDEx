{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metadatos de la edicion RINDEx",
  "type": "object",
  "required": [
    "version_esquema",
    "id_edicion",
    "nombre_visible",
    "region",
    "anios",
    "cultivos",
    "departamentos",
    "departamentos_excluidos",
    "commit_hash",
    "fecha_generacion",
    "semilla_aleatoria",
    "umbrales",
    "fuentes"
  ],
  "additionalProperties": false,
  "properties": {
    "version_esquema": { "type": "string", "minLength": 1 },
    "id_edicion": { "type": "string", "minLength": 1 },
    "nombre_visible": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "anios": {
      "type": "object",
      "required": ["inicio", "fin"],
      "additionalProperties": false,
      "properties": {
        "inicio": { "type": "integer" },
        "fin": { "type": "integer" }
      }
    },
    "cultivos": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "departamentos": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "departamentos_excluidos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["codigo", "nombre", "motivo"],
        "additionalProperties": false,
        "properties": {
          "codigo": { "type": "string" },
          "nombre": { "type": "string" },
          "motivo": { "type": "string" }
        }
      }
    },
    "commit_hash": { "type": "string", "minLength": 7 },
    "fecha_generacion": { "type": "string", "minLength": 10 },
    "semilla_aleatoria": { "type": "integer" },
    "umbrales": {
      "type": "object",
      "required": [
        "area_cosechada_minima_ha",
        "anios_minimos_con_dato",
        "replicas_bootstrap",
        "juegos_dirichlet",
        "top_k",
        "umbral_robustez_top_pct"
      ],
      "additionalProperties": false,
      "properties": {
        "area_cosechada_minima_ha": { "type": "integer" },
        "anios_minimos_con_dato": { "type": "integer" },
        "replicas_bootstrap": { "type": "integer" },
        "juegos_dirichlet": { "type": "integer" },
        "top_k": { "type": "integer" },
        "umbral_robustez_top_pct": { "type": "number" }
      }
    },
    "fuentes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "nombre", "url", "licencia", "hash_sha256"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "nombre": { "type": "string" },
          "url": { "type": "string" },
          "licencia": { "type": "string" },
          "hash_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "version": { "type": "string" }
        }
      }
    }
  }
}
